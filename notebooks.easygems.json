turn ds.crs.healpix_nside\n\n# The dataset used in this section uses the old easygems CRS convention. \n# The new easygems (>=0.1.4) `guess_crs()` seems to be looking for these via \n# `cf_xarray`'s grid mapping mechanism, which fails on the old data format\n# So we will need to assign \"crs\" coords of the dataset properly\ndef fix_crs(ds):\n    import xarray as xr\n    \n    crs_scalar = xr.DataArray(\n        attrs={\n            \"grid_mapping_name\": \"healpix\",\n            \"healpix_nside\": get_nside(ds),\n            \"healpix_order\": str(ds.crs.healpix_order),\n        }\n    )\n    return ds.assign_coords(crs=crs_scalar)","key":"pB1EqfrgE7"},{"type":"outputs","id":"gdYI-sUCu9VoB-Ke6sP6m","children":[],"key":"g3usTPQqtS"}],"key":"s9qYQ3lnyr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"HEALPix pixel containing Boulder’s coords","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OwhUNOCPy6"}],"identifier":"healpix-pixel-containing-boulders-coords","label":"HEALPix pixel containing Boulder’s coords","html_id":"healpix-pixel-containing-boulders-coords","implicit":true,"key":"RBr4HzxoUr"}],"key":"g0A8uD9txP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nboulder_lon = -105.2747\nboulder_lat = 40.0190\n\nboulder_pixel = hp.ang2pix(\n    get_nside(ds_fine), boulder_lon, boulder_lat, lonlat=True, nest=get_nest(ds_fine)\n)","key":"TXgkIfX0Ia"},{"type":"outputs","id":"GB7N6tuYk7AlNy_Ys2e5A","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"CPU times: user 400 μs, sys: 0 ns, total: 400 μs\nWall time: 365 μs\n"},"key":"CixBIIRDuW"}],"key":"Uq8ElWP4EQ"}],"key":"gGkzUqASWJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start